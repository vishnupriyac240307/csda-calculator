# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/csda_calculator?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/csda_calculator?retryWrites=true&w=majority

# JWT Session Authentication Secret (Use a strong 64+ character random secret in production)
JWT_SECRET=your_super_secret_jwt_key_csda_calculator_2026_change_in_production

# Frontend Client URL for CORS
FRONTEND_URL=http://localhost:3000
